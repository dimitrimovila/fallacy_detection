# The image of the jobs on a cluster without conda: the official image of vLLM 0.30.0,
# with the libraries of the client added. The client itself is not installed: the jobs
# import it from src/ of the repository (serving/slurm/common.sh, CONTAINER in the .env).
#
# Built on a compute node, not on the front-end, from the root of the repository, with
# the temporary files and the cache of Apptainer on the project storage (the image is
# about 9 GB):
#
#   mkdir -p $IMAGES/tmp $IMAGES/cache
#   export APPTAINER_TMPDIR=$IMAGES/tmp APPTAINER_CACHEDIR=$IMAGES/cache
#   apptainer build --ignore-fakeroot-command $IMAGES/vllm-0.30.0.sif serving/apptainer/vllm.def

Bootstrap: docker
From: vllm/vllm-openai:v0.30.0

%post
    # the packages of vLLM stay as they are: pip adds only what is missing
    python3 -m pip install --no-cache-dir "pyyaml>=6.0" "pandas>=2.0" "openai>=1.30" \
        "openpyxl>=3.1" "jsonschema>=4.0"
    python3 -c 'import vllm, torch; print(f"vLLM {vllm.__version__}, PyTorch {torch.__version__}")'
