# Fixed line endings. The cluster runs Linux, and the hash of schemes/ recorded in the manifest of
# every run must not depend on the operating system the repository was cloned on. A job script
# with CRLF does not run there at all.
*.csv   text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sh     text eol=lf
*.sbatch text eol=lf
