# Runs: raw JSONL and manifests, never versioned.
# The code regenerates them, and they are large. Anything in the thesis comes from argfallacy.eval.
runs/

# Raw data: kept outside the repository, and it belongs to the research group.
# Under data/ only items.csv and annotations.csv go into git.
*.xlsx
*.rar

# Secrets: API keys and tokens are read from environment variables.
.env
.env.*

# Temporary verification files: all here, never scattered around the repository.
scratch/

# Caches and build artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# System and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
